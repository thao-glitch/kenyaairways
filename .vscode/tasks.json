{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "setup: install / upgrade everything",
      "type": "shell",
      "command": "./setup.sh",
      "windows": { "command": ".\\INSTALL.bat" },
      "problemMatcher": []
    },
    {
      "label": "start: all apps (:3000 :3001 :4100)",
      "type": "shell",
      "command": "./start.sh",
      "windows": { "command": ".\\START.bat" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "db: apply schema",
      "type": "shell",
      "command": "pnpm db:push",
      "problemMatcher": []
    },
    {
      "label": "db: seed worldwide network",
      "type": "shell",
      "command": "pnpm db:seed",
      "problemMatcher": []
    }
  ]
}
