{
  "expo": {
    "name": "Kenya Airways",
    "slug": "kenyaairways",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "kenyaairways",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ke.co.kenyaairways"
    },
    "android": {
      "package": "ke.co.kenyaairways",
      "versionCode": 1,
      "edgeToEdgeEnabled": true
    },
    "plugins": ["expo-secure-store", "expo-sqlite"]
  }
}
