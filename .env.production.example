# ══════════════════════════════════════════════════════════════════════
# Kenya Airways — PRODUCTION environment template
# Copy to `.env` and fill in every value marked CHANGE-ME / your-subdomain.
# Generated from .env.example; keep both in sync when adding new variables.
# ══════════════════════════════════════════════════════════════════════

# ── Deployment (public domains) ─────────────────────────────────────────
# Your free subdomain (e.g. a DuckDNS name) pointing at this box.
SITE_URL=https://your-subdomain.duckdns.org
ADMIN_URL=https://admin.your-subdomain.duckdns.org
NEXT_PUBLIC_ADMIN_URL=https://admin.your-subdomain.duckdns.org
# Email Caddy uses for Let's Encrypt certificate registration.
ACME_EMAIL=you@example.com
# HTTP basic auth for the admin console (generate the hash with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password')
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=CHANGE-ME-bcrypt-hash

# ══════════════════════════════════════════════════════════════════════
# Kenya Airways — environment template
# Copy to `.env` (or run `pnpm bootstrap` which does it and fills secrets).
# Values marked __GENERATE__ / __GENERATE_32B__ are replaced with random
# values by the bootstrap script — never commit a real secret.
# ══════════════════════════════════════════════════════════════════════

# ── Runtime ─────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4100
LOG_LEVEL=info
ENABLE_SWAGGER=false

# ── URLs & CORS ─────────────────────────────────────────────────────────
API_PUBLIC_URL=http://api:4100
WEB_PUBLIC_URL=https://your-subdomain.duckdns.org
NEXT_PUBLIC_API_URL=http://api:4100
CORS_ORIGINS=https://your-subdomain.duckdns.org,https://admin.your-subdomain.duckdns.org

# ── Secrets (generated by `pnpm bootstrap`) ─────────────────────────────
JWT_ACCESS_SECRET=__GENERATE__
JWT_REFRESH_SECRET=__GENERATE__
SESSION_COOKIE_SECRET=__GENERATE__
# AES-256-GCM key for ID/passport encryption at rest (32 bytes, base64)
ENCRYPTION_KEY=__GENERATE_32B__
# Random token embedded in callback URL paths (Safaricom does not sign callbacks)
MPESA_CALLBACK_SECRET=__GENERATE__

# ── Database ────────────────────────────────────────────────────────────
# docker-compose defaults (dev-only credentials, change for production)
POSTGRES_USER=kenyaairways
POSTGRES_PASSWORD=CHANGE-ME-strong-random
POSTGRES_DB=kenyaairways
POSTGRES_PORT=5432
DATABASE_URL=postgresql://kenyaairways:CHANGE-ME-strong-random@db:5432/kenyaairways
DATABASE_URL_TEST=postgresql://kenyaairways:kenyaairways_dev@localhost:5432/kenyaairways_test
# Set to 1 when running against the compose services (host `postgres`/`redis`)
COMPOSE_DB=0

# ── Redis ───────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Auth ────────────────────────────────────────────────────────────────
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=20

# ── Airline branding & locale ───────────────────────────────────────────
AIRLINE_NAME=Kenya Airways.
AIRLINE_IATA_CODE=F13
DEFAULT_CURRENCY=KES
DEFAULT_TIMEZONE=Africa/Nairobi
DEFAULT_LOCALE=en-KE
SUPPORTED_LOCALES=en-KE,sw-KE

# ── Booking ─────────────────────────────────────────────────────────────
SEAT_HOLD_TTL_SECONDS=600
BOOKING_EXPIRE_TTL_SECONDS=1800
CHECKIN_WINDOW_OPEN_HOURS=24
CHECKIN_WINDOW_CLOSE_HOURS=1
MAX_PAX_PER_BOOKING=9

# ── Payments ────────────────────────────────────────────────────────────
# These are ENVIRONMENT DEFAULTS: the ADMIN "Payment plans" tab overrides
# them per method at runtime (DB rows, hot-reloaded, secrets sealed with
# ENCRYPTION_KEY). MPESA_AMOUNT_ROUNDING and MPESA_CALLBACK_SECRET stay
# env-only by design (finance policy / in-flight callback URLs).
# Provider used when the client does not specify one:
#   MPESA_STK | MPESA_C2B | STRIPE | MOCK
PAYMENT_PROVIDER_DEFAULT=MOCK
# mock = local fake provider (no network); live = real Daraja/Stripe via keys
MPESA_MODE=mock
STRIPE_MODE=mock
# M-Pesa amounts are whole KES: round_up = charge ceil(total) (default),
# round_nearest = charge nearest shilling, reject = fail if not whole
MPESA_AMOUNT_ROUNDING=round_up

# Safaricom Daraja (required when MPESA_MODE=live)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_BASE_URL=https://your-subdomain.duckdns.org/api/v1
# Safaricom IP allowlist (comma separated CIDRs/IPs); empty = disabled (dev only)
MPESA_ALLOWED_CALLBACK_IPS=
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=

# Stripe (required when STRIPE_MODE=live)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Notifications ───────────────────────────────────────────────────────
# SMS_PROVIDER = mock | africastalking | twilio
SMS_PROVIDER=mock
SMS_FROM=Kenya Airways
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
AFRICASTALKING_SENDER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# EMAIL_PROVIDER = mock | resend | sendgrid
EMAIL_PROVIDER=mock
EMAIL_FROM=bookings@kenyaairways.example
RESEND_API_KEY=
SENDGRID_API_KEY=

# PUSH_PROVIDER = mock | webpush
PUSH_PROVIDER=mock
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@kenyaairways.example

# ── Flight data ─────────────────────────────────────────────────────────
# FLIGHT_DATA_PROVIDER = internal | external | mock
FLIGHT_DATA_PROVIDER=internal
EXTERNAL_FEED_BASE_URL=
EXTERNAL_FEED_API_KEY=

# ── Jobs / simulator ────────────────────────────────────────────────────
# Demo/test flight lifecycle simulation (scheduled -> boarding -> in air -> landed)
FLIGHT_SIMULATOR_ENABLED=false
FLIGHT_SIMULATOR_TICK_MS=30000
RECONCILE_STK_AFTER_SECONDS=75

# ── Compliance (Kenya Data Protection Act 2019) ─────────────────────────
PRIVACY_POLICY_VERSION=2026-01
DATA_RETENTION_BOOKING_DAYS=2555
DATA_RETENTION_LOG_DAYS=365
# KCAA passenger manifest reporting extension point
REPORTING_MANIFEST_OPERATOR=
# Empty URL = no-op dispatcher (manifest recorded locally, nothing sent).
# When set, manifests are POSTed as JSON with `Authorization: Bearer $KCAA_MANIFEST_TOKEN`.
KCAA_MANIFEST_URL=
KCAA_MANIFEST_TOKEN=

# ── Seed (dev only) ─────────────────────────────────────────────────────
SEED_USER_PASSWORD=
