[Desktop Entry]
Type=Application
Version=1.0
Name=Install Kenya Airways
GenericName=Platform installer
Comment=Install or upgrade the Kenya Airways platform automatically (no terminal needed)
Exec=bash -c "cd \"\$(dirname \"%k\")\" && if [ -f \"Install Kenya Airways.sh\" ]; then exec bash \"Install Kenya Airways.sh\"; else exec bash INSTALL.sh; fi"
Terminal=true
Icon=utilities-terminal
Categories=Utility;
StartupNotify=false
