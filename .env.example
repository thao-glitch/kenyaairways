# ══════════════════════════════════════════════════════════════════════
# Flight13 — environment template
# Copy to `.env` (or run `pnpm bootstrap` which does it and fills secrets).
# Values marked __GENERATE__ / __GENERATE_32B__ are replaced with random
# values by the bootstrap script — never commit a real secret.
# ══════════════════════════════════════════════════════════════════════

# ── Runtime ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
ENABLE_SWAGGER=true

# ── URLs & CORS ─────────────────────────────────────────────────────────
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:4000

# ── Secrets (generated by `pnpm bootstrap`) ─────────────────────────────
JWT_ACCESS_SECRET=__GENERATE__
JWT_REFRESH_SECRET=__GENERATE__
SESSION_COOKIE_SECRET=__GENERATE__
# AES-256-GCM key for ID/passport encryption at rest (32 bytes, base64)
ENCRYPTION_KEY=__GENERATE_32B__
# Random token embedded in callback URL paths (Safaricom does not sign callbacks)
MPESA_CALLBACK_SECRET=__GENERATE__

# ── Database ────────────────────────────────────────────────────────────
# docker-compose defaults (dev-only credentials, change for production)
POSTGRES_USER=flight13
POSTGRES_PASSWORD=flight13_dev
POSTGRES_DB=flight13
POSTGRES_PORT=5432
DATABASE_URL=postgresql://flight13:flight13_dev@localhost:5432/flight13
DATABASE_URL_TEST=postgresql://flight13:flight13_dev@localhost:5432/flight13_test
# Set to 1 when running against the compose services (host `postgres`/`redis`)
COMPOSE_DB=0

# ── Redis ───────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ────────────────────────────────────────────────────────────────
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=20

# ── Airline branding & locale ───────────────────────────────────────────
AIRLINE_NAME=Flight13
AIRLINE_IATA_CODE=F13
DEFAULT_CURRENCY=KES
DEFAULT_TIMEZONE=Africa/Nairobi
DEFAULT_LOCALE=en-KE
SUPPORTED_LOCALES=en-KE,sw-KE

# ── Booking ─────────────────────────────────────────────────────────────
SEAT_HOLD_TTL_SECONDS=600
BOOKING_EXPIRE_TTL_SECONDS=1800
CHECKIN_WINDOW_OPEN_HOURS=24
CHECKIN_WINDOW_CLOSE_HOURS=1
MAX_PAX_PER_BOOKING=9

# ── Payments ────────────────────────────────────────────────────────────
# Provider used when the client does not specify one:
#   MPESA_STK | MPESA_C2B | STRIPE | MOCK
PAYMENT_PROVIDER_DEFAULT=MOCK
# mock = local fake provider (no network); live = real Daraja/Stripe via keys
MPESA_MODE=mock
STRIPE_MODE=mock
# M-Pesa amounts are whole KES: round_up = charge ceil(total) (default),
# round_nearest = charge nearest shilling, reject = fail if not whole
MPESA_AMOUNT_ROUNDING=round_up

# Safaricom Daraja (required when MPESA_MODE=live)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_BASE_URL=http://localhost:4000
# Safaricom IP allowlist (comma separated CIDRs/IPs); empty = disabled (dev only)
MPESA_ALLOWED_CALLBACK_IPS=
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=

# Stripe (required when STRIPE_MODE=live)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Notifications ───────────────────────────────────────────────────────
# SMS_PROVIDER = mock | africastalking | twilio
SMS_PROVIDER=mock
SMS_FROM=Flight13
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
AFRICASTALKING_SENDER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# EMAIL_PROVIDER = mock | resend | sendgrid
EMAIL_PROVIDER=mock
EMAIL_FROM=bookings@flight13.example
RESEND_API_KEY=
SENDGRID_API_KEY=

# PUSH_PROVIDER = mock | webpush
PUSH_PROVIDER=mock
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@flight13.example

# ── Flight data ─────────────────────────────────────────────────────────
# FLIGHT_DATA_PROVIDER = internal | external | mock
FLIGHT_DATA_PROVIDER=internal
EXTERNAL_FEED_BASE_URL=
EXTERNAL_FEED_API_KEY=

# ── Jobs / simulator ────────────────────────────────────────────────────
# Demo/test flight lifecycle simulation (scheduled -> boarding -> in air -> landed)
FLIGHT_SIMULATOR_ENABLED=false
FLIGHT_SIMULATOR_TICK_MS=30000
RECONCILE_STK_AFTER_SECONDS=75

# ── Compliance (Kenya Data Protection Act 2019) ─────────────────────────
PRIVACY_POLICY_VERSION=2026-01
DATA_RETENTION_BOOKING_DAYS=2555
DATA_RETENTION_LOG_DAYS=365
# KCAA passenger manifest reporting extension point
REPORTING_MANIFEST_OPERATOR=
# Empty URL = no-op dispatcher (manifest recorded locally, nothing sent).
# When set, manifests are POSTed as JSON with `Authorization: Bearer $KCAA_MANIFEST_TOKEN`.
KCAA_MANIFEST_URL=
KCAA_MANIFEST_TOKEN=

# ── Seed (dev only) ─────────────────────────────────────────────────────
SEED_USER_PASSWORD=Password123!
